{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rn-games-live",
  "account_id": "cb68a7648183fcfcc61623ced7fd5ceb",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_ROOMS",
        "class_name": "LiveRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LiveRoom"
      ]
    }
  ],
  "vars": {
    "LIVE_ALLOWED_ORIGINS": "https://rn-games.netlify.app"
  },
  "observability": {
    "enabled": false
  }
}
